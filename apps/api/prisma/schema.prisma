generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

/// Papel único por usuário (RBAC — ADR-004). Sem tabelas Role/Permission
/// nesta sprint: ver "Future Evolution" em ADR-004 para os gatilhos que
/// justificariam evoluir para um modelo normalizado.
enum Role {
  SUPER_ADMIN
  ADMIN
  USER
}

model User {
  id          String   @id @default(cuid())
  email       String   @unique
  password    String
  name        String
  active      Boolean  @default(true)
  role        Role     @default(USER)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  refreshTokens RefreshToken[]
  projects      Project[]

  @@map("users")
}

/// Primeiro agregado de negócio do domínio (ADR-008 / SPR-009, Bloco A).
/// Ciclo de vida via `status`, não via DELETE físico — "excluir" um
/// projeto significa arquivá-lo (ver ADR-008 para a justificativa).
enum ProjectStatus {
  ACTIVE
  ARCHIVED
}

model Project {
  id          String        @id @default(cuid())
  name        String
  description String?
  status      ProjectStatus @default(ACTIVE)
  ownerId     String
  owner       User          @relation(fields: [ownerId], references: [id])

  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  campaigns   Campaign[]

  @@index([ownerId])
  @@map("projects")
}

/// Segundo agregado de negócio do domínio (ADR-011 / SPR-012, Bloco A).
/// Agregado independente associado a `Project` (Project 1:N Campaign, via
/// Campaign.projectId) — não é entidade interna do agregado Project.
/// Ciclo de vida via `status`, não via DELETE físico, mesma justificativa
/// de recuperabilidade da ADR-008. Sem ownerId próprio — a propriedade é
/// derivada do Project associado (ver ADR-011, Ownership).
enum CampaignStatus {
  ACTIVE
  ARCHIVED
}

model Campaign {
  id          String         @id @default(cuid())
  name        String
  description String?
  status      CampaignStatus @default(ACTIVE)
  projectId   String
  project     Project        @relation(fields: [projectId], references: [id])

  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([projectId])
  @@map("campaigns")
}

model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  tokenHash String   @unique
  expiresAt DateTime
  revokedAt DateTime?

  // Encadeamento de rotação: aponta para o token que substituiu este,
  // quando ele foi rotacionado. Necessário para detecção de reuso
  // (ADR-002 / SPR-006, seção 7.4) — se um token com replacedByTokenId
  // preenchido for apresentado novamente, é sinal de token comprometido.
  replacedByTokenId String?       @unique
  replacedByToken   RefreshToken? @relation("TokenRotation", fields: [replacedByTokenId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  replacedToken     RefreshToken? @relation("TokenRotation")

  createdAt DateTime @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}