generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id          String   @id @default(cuid())
  email       String   @unique
  password    String
  name        String
  active      Boolean  @default(true)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  refreshTokens RefreshToken[]

  @@map("users")
}

model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  tokenHash String   @unique
  expiresAt DateTime
  revokedAt DateTime?

  // Encadeamento de rotação: aponta para o token que substituiu este,
  // quando ele foi rotacionado. Necessário para detecção de reuso
  // (ADR-002 / SPR-006, seção 7.4) — se um token com replacedByTokenId
  // preenchido for apresentado novamente, é sinal de token comprometido.
  replacedByTokenId String?       @unique
  replacedByToken   RefreshToken? @relation("TokenRotation", fields: [replacedByTokenId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  replacedToken     RefreshToken? @relation("TokenRotation")

  createdAt DateTime @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}