# Variáveis de ambiente para os testes E2E (apps/api/test/**/*.e2e-spec.ts).
#
# Este arquivo é versionado de propósito: os testes E2E devem inicializar a
# aplicação em qualquer ambiente limpo (CI, clone novo) sem depender do
# `.env` pessoal do desenvolvedor. Carregado por `test/env-setup.ts`
# (Jest `setupFiles`) antes do bootstrap do Nest.
#
# Os valores abaixo não são segredos de produção — servem apenas para
# satisfazer a validação de `env.validation.ts` em ambiente de teste.
# Qualquer variável já definida no processo (ex.: exportada pelo CI) tem
# prioridade e não é sobrescrita.

NODE_ENV=test
PORT=3001
DATABASE_URL=postgresql://content_os:content_os@localhost:5432/content_os
APP_NAME=Content OS
APP_VERSION=0.2.0

JWT_SECRET=e2e-test-secret-nao-usar-em-producao
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
