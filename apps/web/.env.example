# Variáveis do servidor do apps/web (todas obrigatórias, sem valor padrão).
# Copie para `.env.local` e ajuste. Nenhuma usa NEXT_PUBLIC_.

# URL base da API (esquema + host [+ porta]), sem credenciais.
API_BASE_URL=http://localhost:3001

# Max-Age dos cookies de sessão, em segundos (inteiro positivo).
# NÃO pode exceder o JWT_REFRESH_TTL EFETIVO da API do MESMO ambiente.
# O valor de exemplo (7 dias) é referência apenas para o ambiente local
# (JWT_REFRESH_TTL=7d); confirme o valor efetivo de cada ambiente.
SESSION_COOKIE_MAX_AGE_SECONDS=604800

# Origem pública vista pelo navegador (esquema + host + porta), sem path.
# Usada para validar o header Origin dos POST de sessão.
APP_ORIGIN=http://localhost:3000
